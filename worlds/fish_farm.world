<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="fish_farm_world">

    <!-- =================================================================== -->
    <!-- PHYSICS & SCENE CONFIGURATION                                       -->
    <!-- =================================================================== -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.65 0.72 0.78 1.0</ambient>
      <background>0.52 0.75 0.92 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Directional Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- =================================================================== -->
    <!-- POND FLOOR & BOUNDING WALLS (14m x 14m Aquaculture Pond)            -->
    <!-- =================================================================== -->
    <model name="aquaculture_pond_structure">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Pond Floor (Collision + Dark Teal Floor Visual) -->
      <link name="pond_floor">
        <collision name="floor_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>16.0 16.0 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>14.4 14.4 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.22 0.28 1</ambient>
            <diffuse>0.10 0.26 0.32 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- North Wall (+X = +7.0m) -->
        <collision name="wall_north_col">
          <pose>7.0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.4 14.4 1.1</size></box></geometry>
        </collision>
        <visual name="wall_north_vis">
          <pose>7.0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.4 14.4 1.1</size></box></geometry>
          <material>
            <ambient>0.45 0.47 0.50 1</ambient>
            <diffuse>0.55 0.58 0.60 1</diffuse>
          </material>
        </visual>

        <!-- South Wall (-X = -7.0m) -->
        <collision name="wall_south_col">
          <pose>-7.0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.4 14.4 1.1</size></box></geometry>
        </collision>
        <visual name="wall_south_vis">
          <pose>-7.0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.4 14.4 1.1</size></box></geometry>
          <material>
            <ambient>0.45 0.47 0.50 1</ambient>
            <diffuse>0.55 0.58 0.60 1</diffuse>
          </material>
        </visual>

        <!-- East Wall (+Y = +7.0m) -->
        <collision name="wall_east_col">
          <pose>0 7.0 0.5 0 0 0</pose>
          <geometry><box><size>14.4 0.4 1.1</size></box></geometry>
        </collision>
        <visual name="wall_east_vis">
          <pose>0 7.0 0.5 0 0 0</pose>
          <geometry><box><size>14.4 0.4 1.1</size></box></geometry>
          <material>
            <ambient>0.45 0.47 0.50 1</ambient>
            <diffuse>0.55 0.58 0.60 1</diffuse>
          </material>
        </visual>

        <!-- West Wall (-Y = -7.0m) -->
        <collision name="wall_west_col">
          <pose>0 -7.0 0.5 0 0 0</pose>
          <geometry><box><size>14.4 0.4 1.1</size></box></geometry>
        </collision>
        <visual name="wall_west_vis">
          <pose>0 -7.0 0.5 0 0 0</pose>
          <geometry><box><size>14.4 0.4 1.1</size></box></geometry>
          <material>
            <ambient>0.45 0.47 0.50 1</ambient>
            <diffuse>0.55 0.58 0.60 1</diffuse>
          </material>
        </visual>

        <!-- Semi-Transparent Water Surface Plane -->
        <visual name="water_surface_plane">
          <pose>0 0 0.035 0 0 0</pose>
          <transparency>0.62</transparency>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>13.6 13.6 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.48 0.68 0.38</ambient>
            <diffuse>0.08 0.55 0.78 0.38</diffuse>
            <specular>0.6 0.6 0.6 0.38</specular>
          </material>
        </visual>

        <!-- HOME / REFILL DOCK AT (0.0, 0.0) -->
        <visual name="home_dock_pad">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.75</radius>
              <length>0.006</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.88 0.92 1</ambient>
            <diffuse>0.92 0.95 0.98 1</diffuse>
          </material>
        </visual>
        <visual name="home_dock_inner">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.48</radius>
              <length>0.006</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.10 0.38 0.85 1</ambient>
            <diffuse>0.12 0.42 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- FEEDING ZONE 1 (X=3.5, Y=3.5): HIGH FISH AGGREGATION / DEPLETED     -->
    <!-- Needs immediate feeding! Vibrant exposed cyan tray + dense orange   -->
    <!-- fish school cluster so OpenCV camera detects ~85-95% demand.        -->
    <!-- =================================================================== -->
    <model name="feeding_zone_1_high_demand">
      <static>true</static>
      <pose>3.5 3.5 0.0 0 0 0</pose>
      <link name="zone_1_link">
        <!-- Depleted Feed Tray Base (Bright Cyan/Turquoise Floor Disc) -->
        <visual name="z1_tray">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry>
            <cylinder><radius>1.35</radius><length>0.008</length></cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.72 0.85 1</ambient>
            <diffuse>0.0 0.82 0.95 1</diffuse>
          </material>
        </visual>

        <!-- High-Density Active Fish School (Vibrant Orange/Gold Fish Silhouettes) -->
        <visual name="z1_fish_1"><pose>0.0 0.0 0.018 0 1.57 0.2</pose><geometry><cylinder><radius>0.09</radius><length>0.34</length></cylinder></geometry><material><ambient>0.95 0.38 0.02 1</ambient><diffuse>1.0 0.42 0.05 1</diffuse></material></visual>
        <visual name="z1_fish_2"><pose>0.28 0.18 0.018 0 1.57 0.8</pose><geometry><cylinder><radius>0.085</radius><length>0.32</length></cylinder></geometry><material><ambient>0.98 0.45 0.04 1</ambient><diffuse>1.0 0.50 0.06 1</diffuse></material></visual>
        <visual name="z1_fish_3"><pose>-0.25 0.22 0.018 0 1.57 -0.5</pose><geometry><cylinder><radius>0.09</radius><length>0.35</length></cylinder></geometry><material><ambient>0.95 0.32 0.02 1</ambient><diffuse>1.0 0.36 0.04 1</diffuse></material></visual>
        <visual name="z1_fish_4"><pose>0.22 -0.26 0.018 0 1.57 1.4</pose><geometry><cylinder><radius>0.085</radius><length>0.33</length></cylinder></geometry><material><ambient>0.95 0.40 0.03 1</ambient><diffuse>1.0 0.45 0.05 1</diffuse></material></visual>
        <visual name="z1_fish_5"><pose>-0.30 -0.20 0.018 0 1.57 2.1</pose><geometry><cylinder><radius>0.09</radius><length>0.34</length></cylinder></geometry><material><ambient>0.95 0.35 0.02 1</ambient><diffuse>1.0 0.40 0.04 1</diffuse></material></visual>
        <visual name="z1_fish_6"><pose>0.48 0.0 0.018 0 1.57 -1.1</pose><geometry><cylinder><radius>0.085</radius><length>0.31</length></cylinder></geometry><material><ambient>0.98 0.48 0.05 1</ambient><diffuse>1.0 0.52 0.06 1</diffuse></material></visual>
        <visual name="z1_fish_7"><pose>-0.45 0.02 0.018 0 1.57 0.4</pose><geometry><cylinder><radius>0.085</radius><length>0.32</length></cylinder></geometry><material><ambient>0.95 0.38 0.02 1</ambient><diffuse>1.0 0.42 0.05 1</diffuse></material></visual>
        <visual name="z1_fish_8"><pose>0.05 0.45 0.018 0 1.57 1.9</pose><geometry><cylinder><radius>0.09</radius><length>0.34</length></cylinder></geometry><material><ambient>0.95 0.32 0.02 1</ambient><diffuse>1.0 0.38 0.04 1</diffuse></material></visual>
        <visual name="z1_fish_9"><pose>-0.05 -0.46 0.018 0 1.57 -0.9</pose><geometry><cylinder><radius>0.09</radius><length>0.33</length></cylinder></geometry><material><ambient>0.96 0.42 0.03 1</ambient><diffuse>1.0 0.46 0.05 1</diffuse></material></visual>
        <visual name="z1_fish_10"><pose>0.38 0.36 0.018 0 1.57 0.6</pose><geometry><cylinder><radius>0.085</radius><length>0.30</length></cylinder></geometry><material><ambient>0.95 0.36 0.02 1</ambient><diffuse>1.0 0.40 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- FEEDING ZONE 2 (X=-3.5, Y=3.5): NORMAL BALANCED ZONE                -->
    <!-- Healthy water parameters, moderate fish density & feeding activity. -->
    <!-- =================================================================== -->
    <model name="feeding_zone_2_normal">
      <static>true</static>
      <pose>-3.5 3.5 0.0 0 0 0</pose>
      <link name="zone_2_link">
        <visual name="z2_tray">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry>
            <cylinder><radius>1.35</radius><length>0.008</length></cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.62 0.45 1</ambient>
            <diffuse>0.15 0.72 0.52 1</diffuse>
          </material>
        </visual>

        <!-- Moderate Fish Group -->
        <visual name="z2_fish_1"><pose>0.10 0.12 0.018 0 1.57 0.3</pose><geometry><cylinder><radius>0.085</radius><length>0.32</length></cylinder></geometry><material><ambient>0.95 0.40 0.03 1</ambient><diffuse>1.0 0.45 0.05 1</diffuse></material></visual>
        <visual name="z2_fish_2"><pose>-0.24 0.15 0.018 0 1.57 1.2</pose><geometry><cylinder><radius>0.085</radius><length>0.31</length></cylinder></geometry><material><ambient>0.95 0.38 0.02 1</ambient><diffuse>1.0 0.42 0.05 1</diffuse></material></visual>
        <visual name="z2_fish_3"><pose>0.20 -0.22 0.018 0 1.57 -0.7</pose><geometry><cylinder><radius>0.085</radius><length>0.32</length></cylinder></geometry><material><ambient>0.95 0.42 0.03 1</ambient><diffuse>1.0 0.48 0.05 1</diffuse></material></visual>
        <visual name="z2_fish_4"><pose>-0.18 -0.25 0.018 0 1.57 2.0</pose><geometry><cylinder><radius>0.085</radius><length>0.30</length></cylinder></geometry><material><ambient>0.95 0.36 0.02 1</ambient><diffuse>1.0 0.40 0.05 1</diffuse></material></visual>
        <visual name="z2_fish_5"><pose>0.35 0.05 0.018 0 1.57 -1.3</pose><geometry><cylinder><radius>0.08</radius><length>0.29</length></cylinder></geometry><material><ambient>0.95 0.40 0.03 1</ambient><diffuse>1.0 0.45 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- FEEDING ZONE 3 (X=-3.5, Y=-3.5): POOR WATER QUALITY ANOMALY ZONE    -->
    <!-- Low Dissolved Oxygen (3.1 mg/L < 4.0) & Acidic pH (5.8 < 6.5).      -->
    <!-- Dark murky purple-brown anoxic floor patch.                         -->
    <!-- =================================================================== -->
    <model name="feeding_zone_3_poor_water_quality">
      <static>true</static>
      <pose>-3.5 -3.5 0.0 0 0 0</pose>
      <link name="zone_3_link">
        <visual name="z3_anoxic_patch">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry>
            <cylinder><radius>1.35</radius><length>0.008</length></cylinder>
          </geometry>
          <material>
            <ambient>0.42 0.12 0.35 1</ambient>
            <diffuse>0.48 0.15 0.40 1</diffuse>
          </material>
        </visual>

        <!-- Algae / Uneaten Decomposing Sediment Spots -->
        <visual name="z3_sediment_1"><pose>0.25 0.20 0.012 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.01</length></cylinder></geometry><material><ambient>0.35 0.28 0.10 1</ambient><diffuse>0.42 0.32 0.12 1</diffuse></material></visual>
        <visual name="z3_sediment_2"><pose>-0.30 -0.18 0.012 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.01</length></cylinder></geometry><material><ambient>0.35 0.28 0.10 1</ambient><diffuse>0.42 0.32 0.12 1</diffuse></material></visual>
        <visual name="z3_fish_1"><pose>0.0 0.05 0.018 0 1.57 0.5</pose><geometry><cylinder><radius>0.085</radius><length>0.30</length></cylinder></geometry><material><ambient>0.90 0.35 0.05 1</ambient><diffuse>0.95 0.40 0.05 1</diffuse></material></visual>
        <visual name="z3_fish_2"><pose>-0.15 0.28 0.018 0 1.57 -0.8</pose><geometry><cylinder><radius>0.085</radius><length>0.30</length></cylinder></geometry><material><ambient>0.90 0.35 0.05 1</ambient><diffuse>0.95 0.40 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- FEEDING ZONE 4 (X=3.5, Y=-3.5): HIGH ACTIVITY & SEDIMENT AGITATION  -->
    <!-- High fish feeding activity (~80% demand) with safe DO & pH.         -->
    <!-- =================================================================== -->
    <model name="feeding_zone_4_active_school">
      <static>true</static>
      <pose>3.5 -3.5 0.0 0 0 0</pose>
      <link name="zone_4_link">
        <visual name="z4_tray">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry>
            <cylinder><radius>1.35</radius><length>0.008</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.65 0.80 1</ambient>
            <diffuse>0.08 0.75 0.90 1</diffuse>
          </material>
        </visual>

        <!-- Active Fish School -->
        <visual name="z4_fish_1"><pose>0.05 0.05 0.018 0 1.57 0.1</pose><geometry><cylinder><radius>0.09</radius><length>0.33</length></cylinder></geometry><material><ambient>0.95 0.38 0.02 1</ambient><diffuse>1.0 0.44 0.05 1</diffuse></material></visual>
        <visual name="z4_fish_2"><pose>0.26 -0.15 0.018 0 1.57 1.0</pose><geometry><cylinder><radius>0.09</radius><length>0.32</length></cylinder></geometry><material><ambient>0.98 0.44 0.03 1</ambient><diffuse>1.0 0.48 0.05 1</diffuse></material></visual>
        <visual name="z4_fish_3"><pose>-0.22 0.20 0.018 0 1.57 -0.4</pose><geometry><cylinder><radius>0.09</radius><length>0.34</length></cylinder></geometry><material><ambient>0.95 0.35 0.02 1</ambient><diffuse>1.0 0.40 0.04 1</diffuse></material></visual>
        <visual name="z4_fish_4"><pose>-0.28 -0.22 0.018 0 1.57 1.8</pose><geometry><cylinder><radius>0.085</radius><length>0.31</length></cylinder></geometry><material><ambient>0.95 0.40 0.03 1</ambient><diffuse>1.0 0.45 0.05 1</diffuse></material></visual>
        <visual name="z4_fish_5"><pose>0.35 0.25 0.018 0 1.57 -1.2</pose><geometry><cylinder><radius>0.085</radius><length>0.32</length></cylinder></geometry><material><ambient>0.95 0.38 0.02 1</ambient><diffuse>1.0 0.42 0.05 1</diffuse></material></visual>
        <visual name="z4_fish_6"><pose>0.0 -0.38 0.018 0 1.57 0.7</pose><geometry><cylinder><radius>0.09</radius><length>0.33</length></cylinder></geometry><material><ambient>0.96 0.42 0.03 1</ambient><diffuse>1.0 0.46 0.05 1</diffuse></material></visual>
        <visual name="z4_fish_7"><pose>-0.38 0.0 0.018 0 1.57 2.4</pose><geometry><cylinder><radius>0.085</radius><length>0.31</length></cylinder></geometry><material><ambient>0.95 0.36 0.02 1</ambient><diffuse>1.0 0.40 0.05 1</diffuse></material></visual>
        <visual name="z4_fish_8"><pose>0.12 0.38 0.018 0 1.57 -0.6</pose><geometry><cylinder><radius>0.085</radius><length>0.32</length></cylinder></geometry><material><ambient>0.95 0.38 0.02 1</ambient><diffuse>1.0 0.44 0.05 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
